#!/bin/bash
# Moderation Service CLI wrapper script
# Suppresses Java 25 native access warnings from JLine

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAR_FILE="$SCRIPT_DIR/target/moderation-service-0.0.1-SNAPSHOT.jar"

if [ ! -f "$JAR_FILE" ]; then
    echo "Moderation service not built. Building..."
    (cd "$SCRIPT_DIR" && ../mvnw package -DskipTests -q)
fi

java --enable-native-access=ALL-UNNAMED -jar "$JAR_FILE" "$@"
