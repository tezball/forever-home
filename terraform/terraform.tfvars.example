# Example Terraform variables file
# Copy this file to terraform.tfvars and customize for your environment

# AWS Configuration
aws_region = "us-east-1"
environment = "prod"

# VPC Configuration
vpc_cidr = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]

# ECS Configuration
# Recommended: 512 CPU (0.5 vCPU), 1024 MB memory for production
ecs_task_cpu    = 512
ecs_task_memory = 1024
ecs_desired_count = 2
container_port = 8080

# RDS Configuration
db_instance_class    = "db.t4g.small"
db_allocated_storage = 20
db_name              = "foreverhome"
db_username          = "foreverhome_admin"
db_multi_az          = true

# Database External Access
# WARNING: Only enable for debugging! Should be false in production.
db_publicly_accessible = false

# Application Configuration
admin_email          = "admin@yourdomain.com"
app_base_url         = ""  # Leave empty to use ALB DNS name
cors_allowed_origins = ""

# Email Configuration (REQUIRED for email verification)
email_from = "noreply@yourdomain.com"

# SES Domain Configuration (REQUIRED for email sending)
# This domain must be verified in SES - terraform outputs the required DNS records
# After running terraform apply, add the DNS records shown in the output
ses_domain = "yourdomain.com"

# Database Reset (DANGEROUS!)
# When true, drops ALL tables and re-runs migrations on each deploy
reset_database_on_deploy = false

# S3 Configuration
s3_bucket_name = ""  # Leave empty for auto-generated name

# Domain Configuration
domain_name        = "yourdomain.com"
create_certificate = true

# Route53 DNS Configuration
# Option 1: Use existing Route53 hosted zone
route53_zone_id = ""  # Your existing zone ID (e.g., "Z1234567890ABC")

# Option 2: Create new Route53 hosted zone (if route53_zone_id is empty)
create_route53_zone = false

# Create www subdomain alias
create_www_redirect = true
