# AWS S3 Configuration
# Copy this file to .env and fill in your values
#
# To get these credentials:
# 1. Go to AWS Console → IAM → Users
# 2. Create a new user (or use existing)
# 3. Attach policy: AmazonS3FullAccess (or a custom S3 policy)
# 4. Security credentials → Create access key → Application running outside AWS
# 5. Copy the Access Key ID and Secret Access Key below

AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here
AWS_REGION=eu-west-1
AWS_S3_BUCKET=forever-home-images-dev
